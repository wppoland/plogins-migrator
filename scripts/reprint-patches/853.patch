+        const algorithm = execFileSync(php, ['-r', 'echo in_array("xxh128", hash_algos(), true) ? "xxh128" : "sha256";'], { encoding: 'utf8' });
+        expect(manifest.algorithm).toBe(algorithm);
+        expect(changes()).toEqual([]);
