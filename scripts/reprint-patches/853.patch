+        $begin = json_encode(['type' => 'begin', 'review' => $review]) . "\n";
+        $push = new WordPress\Reprint\Server\DatabaseChangesPush($database, substr($review, 0, 32));
+        try {
+            $push->accept_record_chunk(0, strlen($begin), 0, $begin);
