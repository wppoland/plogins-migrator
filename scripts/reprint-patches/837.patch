+            $result = $client->send_push_request('GET', 'push_db_status', $parameters, ['accepted']);
+            self::assertSame('complete', $result['status']);
+            self::assertSame('complete', $result['response']['phase']);
+        } finally {
+            $processor->close();
+            $client->close();
