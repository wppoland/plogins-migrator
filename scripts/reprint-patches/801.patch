+            'post' => [],
+            'server' => ['REQUEST_METHOD' => 'POST'],
+            'body' => '',
+        ]);
+    }
+
     public function testMultipartParametersDoNotReadTheUploadBody(): void
     {
         $calls = [];
diff --git a/tests/ReprintServerApiAuthenticationTest.php b/tests/ReprintServerApiAuthenticationTest.php
index 795b6217..315fbc7b 100644
--- a/tests/ReprintServerApiAuthenticationTest.php
+++ b/tests/ReprintServerApiAuthenticationTest.php
@@ -121,9 +121,14 @@ final class ReprintServerApiAuthenticationTest extends TestCase {
         $key_client = $this->newKeyClient();
         $this->startServer(['options' => $this->keyOptions($key_client, false)], ['memory_limit' => '24M']);
 
-        $url = $this->endpointUrl(self::PULL_PROBE_ENDPOINT);
+        // Export endpoints are read only from POST parameters, which an opaque
+        // body does not supply, so the dispatcher asks for the endpoint.
+        $url = $this->base_url;
         $headers = $key_client->get_auth_headers('POST', $url) + ['Content-Type' => 'application/octet-stream'];
-        $this->assertReachedDispatcher($this->request($headers, $url, 'POST', str_repeat('x', 32 * 1024 * 1024)));
+        $response = $this->request($headers, $url, 'POST', str_repeat('x', 32 * 1024 * 1024));
+        $this->assertSame(400, $response['status']);
+        $this->assertArrayNotHasKey('reason', $response['body']);
+        $this->assertStringStartsWith('endpoint parameter is required', $response['body']['error']);
     }
 
     public function testKeyHostReportsUnknownKey(): void
@@ -258,14 +263,21 @@ final class ReprintServerApiAuthenticationTest extends TestCase {
     /** @return array{status:int,body:array<string,mixed>} */
     private function pullWithToken(): array
     {
-        return $this->request(( new Site_Export_HMAC_Client(self::TOKEN) )->get_auth_headers(''));
+        // Export endpoints are read only from POST parameters.
+        $body = 'endpoint=' . rawurlencode(self::PULL_PROBE_ENDPOINT);
+        $headers = ( new Site_Export_HMAC_Client(self::TOKEN) )->get_auth_headers($body)
+            + ['Content-Type' => 'application/x-www-form-urlencoded'];
+        return $this->request($headers, $this->base_url, 'POST', $body);
     }
 
     /** @return array{status:int,body:array<string,mixed>} */
     private function pullWithKey(PublicKeyClient $key_client): array
     {
-        $url = $this->endpointUrl(self::PULL_PROBE_ENDPOINT);
-        return $this->request($key_client->get_auth_headers('GET', $url), $url);
+        // Export endpoints are read only from POST parameters.
+        $url = $this->base_url;
+        $headers = $key_client->get_auth_headers('POST', $url)
+            + ['Content-Type' => 'application/x-www-form-urlencoded'];
+        return $this->request($headers, $url, 'POST', 'endpoint=' . rawurlencode(self::PULL_PROBE_ENDPOINT));
     }
 
     /** @return array{status:int,body:array<string,mixed>} */
