# Files excluded from the wp.org build. Migrator has no runtime Composer
# dependencies (vendor/ holds only dev tooling), so it is NOT shipped, the
# bundled PSR-4 fallback autoloader in autoload.php loads src/ directly.
/.git
/.github
/.gitignore
/.distignore
/.wp-env.json
/.wp-env.override.json
/vendor
/node_modules
/tests
/scripts
/docs
/composer.json
/composer.lock
/phpcs.xml.dist
/phpstan.neon.dist
/phpstan-baseline.neon
/README.md
/.DS_Store

.DS_Store
/.wordpress-org
/test-results

# editor backups (never ship / never a badly_named_files reject)
*~
*.bak

# Translation import tooling (GlotPress PO/MO staging) - never ship in the zip
glotpress-import/

# wordpress.org builds language packs from translate.wordpress.org, so a
# catalogue in the package is a duplicate at best, and a bundled .mo shadows the
# pack, meaning a translation corrected upstream never reaches these users until
# the next release. Reel was pended for shipping these. Exclude by FILE TYPE,
# never locale by locale: a per-locale list rots the moment a new locale appears,
# which is exactly how polski-bel.mo walked through a rule naming polski-be_BY.
languages/*.po
languages/*.mo
languages/*.json
languages/*.l10n.php
languages/*.po~
